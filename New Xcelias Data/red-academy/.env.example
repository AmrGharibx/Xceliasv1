# Optional LOCAL configuration. Copy to .env; never commit your .env.
# No shared credentials and no sample-data switch exist.
PORT=3000
HOST=127.0.0.1
APP_URL=http://localhost:3000
APP_ENV=development
DATABASE_MODE=sqlite
DATABASE_PATH=./data/red-academy.db

# External AI drafts are OFF. All other workflows work without an AI account.
# Opt in only after RED approves external processing of limited training metrics.
AI_REPORTS_ENABLED=false
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Production hosting uses HTTPS and a persistent disk, not static hosting.
# See docs/DEPLOYMENT.md. Keep passwords, setup codes and invitation links private.
