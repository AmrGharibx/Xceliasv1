{
  "name": "red-training-academy",
  "version": "2.0.0",
  "description": "Real-Time Master Plan for RED Training Academy in Egypt - Production-Grade Real Estate Platform",
  "main": "server.ultra.js",
  "scripts": {
    "start": "node server.ultra.js",
    "dev": "nodemon server.ultra.js",
    "prices:check": "node scraper/price-intelligence/update-prices.js --mode=hourly --dry-run",
    "prices:daily": "node scraper/price-intelligence/update-prices.js --mode=daily",
    "test:prices": "node --test scraper/price-intelligence/*.test.js",
    "catalog:check": "node scraper/catalog-intelligence/refresh-catalog.js --dry-run",
    "catalog:sync": "node scraper/catalog-intelligence/refresh-catalog.js --apply",
    "test:catalog": "node --test scraper/catalog-intelligence/*.test.js",
    "assets:check": "node scraper/asset-intelligence/refresh-assets.js --dry-run",
    "assets:sync": "node scraper/asset-intelligence/refresh-assets.js --apply",
    "test:assets": "node --test scraper/asset-intelligence/*.test.js",
    "references:check": "node scraper/reference-asset-intelligence/refresh-reference-assets.js --dry-run",
    "references:sync": "node scraper/reference-asset-intelligence/refresh-reference-assets.js --apply",
    "test:references": "node --test scraper/reference-asset-intelligence/*.test.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "real-estate",
    "egypt",
    "north-coast",
    "property",
    "investment"
  ],
  "author": "RED Training Academy",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "qrcode-generator": "^1.4.4"
  },
  "devDependencies": {
    "nodemon": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
