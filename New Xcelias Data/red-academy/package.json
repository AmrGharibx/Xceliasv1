{
  "name": "red-academy-private",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "RED Academy private training operations. Invitation-only, persistent server application.",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "backup": "node scripts/backup.mjs",
    "reset:password": "node scripts/reset-password.mjs",
    "data:status": "node scripts/data-status.mjs",
    "verify:import": "node scripts/verify-import.mjs"
  }
}
